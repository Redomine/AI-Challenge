@page "/"
@implements IDisposable
@inject AssistantSession Session
@inject ScheduledTaskService Scheduler
@inject IWebHostEnvironment Environment
@inject RagQueryService RagQuery
@inject AutoTestRunner AutoTest
@inject RagMiniChatService MiniChat
@inject RagMiniChatScenarioRunner MiniChatTest

<PageTitle>BIM Assistant</PageTitle>

<div class="app-shell">
    <aside class="sidebar">
        <header class="brand">
            <span class="brand-mark">BA</span>
            <div><strong>BIM Assistant</strong><small>Координация и поддержка</small></div>
        </header>

        <nav class="primary-nav" aria-label="Разделы">
            <button class="@NavClass("chat")" @onclick='@(() => OpenSection("chat"))'>Чат</button>
            <button class="@NavClass("rag")" @onclick='@(() => OpenSection("rag"))'>RAG-чат</button>
            <button class="@NavClass("minichat")" @onclick="OpenMiniChatAsync">Mini-чат</button>
            <button class="@NavClass("profiles")" @onclick="OpenProfilesAsync">Профили</button>
            <button class="@NavClass("prompt")" @onclick='@(() => OpenSection("prompt"))'>Базовый prompt</button>
            <button class="@NavClass("invariants")" @onclick="OpenInvariantsAsync">Инварианты</button>
            <button class="@NavClass("memory")" @onclick="OpenMemoryAsync">Память</button>
            <button class="@NavClass("scheduled")" @onclick="OpenScheduledAsync">Периодические задачи</button>
            <button class="@NavClass("revit")" @onclick="OpenRevitAsync">Revit</button>
        </nav>

        <div class="sidebar-status">
            <span class="status-dot @(_ready ? "online" : "")"></span>
            <div><strong>@(_ready ? "Агент готов" : "Подключение")</strong><small>@(_activeProfile?.Name ?? "Без профиля")</small></div>
        </div>
    </aside>

    <main class="workspace @(_section == "chat" ? "chat-workspace" : "")">
        @if (!_ready)
        {
            <section class="empty-state"><h1>BIM Assistant</h1><p>@(_error ?? "Подготавливаю рабочую сессию...")</p></section>
        }
        else if (_section == "chat")
        {
            <header class="workspace-header">
                <div><h1>Диалог</h1><p>Профиль: @(_activeProfile?.Name ?? "не выбран")</p></div>
                <button class="secondary" @onclick="ClearHistoryAsync" disabled="@_busy">Очистить диалог</button>
            </header>
            <section class="task-flow" aria-label="Этапы задачи">
                @foreach (var state in PrimaryTaskStages)
                {
                    <div class="task-stage @TaskStageClass(state)"><strong>@state</strong><span>@TaskStageCaption(state)</span></div>
                }
                <div class="pause-settings">
                    <label><input type="checkbox" checked disabled /> После Planning</label>
                    <label><input type="checkbox" @bind="_pauseAfterExecution" disabled="@TaskIsActive" /> После Execution</label>
                    <label><input type="checkbox" @bind="_pauseAfterValidation" disabled="@TaskIsActive" /> После Validation</label>
                    <label><input type="checkbox" @bind="Session.AutoApproveRevitChanges" disabled="@TaskIsActive" /> Автоматически разрешать запросы</label>
                    <label>Таймаут, мин.<input type="number" min="1" max="120" @bind="Session.OperationTimeoutMinutes" disabled="@TaskIsActive" /></label>
                </div>
            </section>
            <section class="chat-log @(Session.History.Count == 0 ? "empty" : "")" aria-live="polite">
                @if (Session.History.Count == 0)
                {
                    <div class="empty-chat"><h2>Новый диалог</h2><p>Опишите задачу по модели, плагину или скрипту.</p></div>
                }
                @foreach (var message in Session.History)
                {
                    <article class="message @message.Role">
                        @if (IsCollapsibleStageMessage(message))
                        {
                            <details class="stage-message" open="@ShouldExpandStageMessage(message)">
                                <summary>@MessageLabel(message)</summary>
                                <p>@message.Content</p>
                            </details>
                        }
                        else
                        {
                            <span>@MessageLabel(message)</span>
                            <p>@message.Content</p>
                        }
                    </article>
                }
                @if (_busy) { <div class="thinking">Ассистент анализирует запрос...</div> }
            </section>
            <footer class="composer">
                @if (Session.PlanningInterrupted && Session.CurrentTask is not null)
                {
                    <section class="validation-recovery" role="alert">
                        <strong>Планирование прервано</strong>
                        <details open><summary>Причина</summary><pre>@Session.CurrentTask.FailureReason</pre></details>
                        <div>
                            <button class="secondary" @onclick="RetryPlanningAsync" disabled="@_busy">Повторить</button>
                            <button class="secondary" @onclick="SendAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_message))">Отправить уточнение</button>
                            <button class="danger" @onclick="CancelTask" disabled="@_busy">Отменить</button>
                        </div>
                    </section>
                }
                @if (Session.ValidationFailed && Session.CurrentTask is not null)
                {
                    <section class="validation-recovery" role="alert">
                        <strong>Валидация не завершена</strong>
                        <details open><summary>Детали ошибки</summary><pre>@Session.CurrentTask.ValidationResult</pre></details>
                        <div>
                            <button class="secondary" @onclick="RetryValidationAsync" disabled="@_busy">Повторить валидацию</button>
                            @if (Session.CurrentTask.ExecutionRetrySafe)
                            {
                                <button class="secondary" @onclick="RetryExecutionAsync" disabled="@_busy">Повторить выполнение</button>
                            }
                            <button class="secondary" @onclick="ReplanAsync" disabled="@_busy">Пересмотреть план</button>
                            <button class="danger" @onclick="FinishWithoutValidation" disabled="@_busy">Завершить без валидации</button>
                        </div>
                    </section>
                }
                @if (Session.ExecutionInterrupted && Session.CurrentTask is not null)
                {
                    <section class="validation-recovery" role="alert">
                        <strong>Выполнение прервано</strong>
                        <details open><summary>Причина</summary><pre>@Session.CurrentTask.ExecutionResult</pre></details>
                        <div>
                            @if (Session.CurrentTask.ExecutionRetrySafe)
                            {
                                <button class="secondary" @onclick="RetryInterruptedExecutionAsync" disabled="@_busy">Повторить</button>
                                <button class="secondary" @onclick="SendAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_message))">Отправить уточнение</button>
                            }
                            else
                            {
                                <button class="secondary" @onclick="ValidateInterruptedExecutionAsync" disabled="@_busy">Перейти к валидации</button>
                            }
                            <button class="secondary" @onclick="ReplanInterruptedExecutionAsync" disabled="@_busy">Пересмотреть план</button>
                            <button class="danger" @onclick="CancelTask" disabled="@_busy">Отменить</button>
                        </div>
                    </section>
                }
                @if (_lastToolTraces.Count > 0)
                {
                    <details class="tool-details"><summary>Диагностика инструментов</summary>@foreach (var trace in _lastToolTraces) { <pre>@trace</pre> }</details>
                }
                <textarea @bind="_message" @bind:event="oninput" placeholder="Сообщение ассистенту" rows="3" disabled="@_busy"></textarea>
                <div class="composer-actions">
                    <span>@(_lastUsage ?? "Enter в поле переносит строку")</span>
                    @if (Session.AwaitingPlanApproval)
                    {
                        <div class="composer-buttons">
                            <button class="secondary" @onclick="CancelTask" disabled="@_busy">Отменить</button>
                            <button class="secondary" @onclick="SendAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_message))">Отправить уточнение</button>
                            <button class="primary" @onclick="ApprovePlanAsync" disabled="@_busy">Согласовать</button>
                        </div>
                    }
                    else if (Session.AwaitingClarification)
                    {
                        <div class="composer-buttons">
                            <button class="secondary" @onclick="CancelTask" disabled="@_busy">Отменить</button>
                            <button class="primary" @onclick="SendAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_message))">Ответить</button>
                        </div>
                    }
                    else if (Session.IsTaskPaused && !Session.ValidationFailed)
                    {
                        <button class="primary" @onclick="ContinueTaskAsync" disabled="@_busy">Продолжить</button>
                    }
                    else
                    {
                        <button class="primary" @onclick="SendAsync" disabled="@(_busy || TaskIsActive || string.IsNullOrWhiteSpace(_message))">Отправить</button>
                    }
                </div>
            </footer>
        }
        else if (_section == "rag")
        {
            <header class="workspace-header">
                <div>
                    <h1>RAG-чат</h1>
                    <p>Локальный поиск по индексу + LLM либо прямой запрос LLM. Без инструментов Revit.</p>
                </div>
                <div class="rag-mode-toggle">
                    <label class="rag-mode-option @(_ragMode == RagMode.Rag ? "active" : "")">
                        <input type="radio" name="rag-mode" checked="@(_ragMode == RagMode.Rag)" @onchange="() => _ragMode = RagMode.Rag" /> baseline
                    </label>
                    <label class="rag-mode-option @(_ragMode == RagMode.Enhanced ? "active" : "")">
                        <input type="radio" name="rag-mode" checked="@(_ragMode == RagMode.Enhanced)" @onchange="() => _ragMode = RagMode.Enhanced" /> enhanced
                    </label>
                    <label class="rag-mode-option @(_ragMode == RagMode.NoRag ? "active" : "")">
                        <input type="radio" name="rag-mode" checked="@(_ragMode == RagMode.NoRag)" @onchange="() => _ragMode = RagMode.NoRag" /> без RAG
                    </label>
                </div>
            </header>
            <section class="rag-layout">
                <div class="rag-composer">
                    <textarea @bind="_ragQuestion" @bind:event="oninput" rows="3" placeholder="Вопрос по локальной базе знаний" disabled="@_ragBusy"></textarea>
                    @if (_ragMode == RagMode.Enhanced)
                    {
                        <div class="rag-controls">
                            <label>Pre-K<input type="number" min="1" max="64" @bind="_ragPreK" @bind:event="oninput" disabled="@_ragBusy" /></label>
                            <label>Post-K<input type="number" min="1" max="64" @bind="_ragPostK" @bind:event="oninput" disabled="@_ragBusy" /></label>
                            <label>Threshold<input type="number" step="0.05" min="-1" max="1" @bind="_ragThresholdText" @bind:event="oninput" disabled="@_ragBusy" /></label>
                            <span class="rag-control-status @(_ragControlsValid ? "ok" : "fail")">@_ragControlsStatus</span>
                        </div>
                    }
                    <div class="rag-composer-actions">
                        <span class="rag-status">@_ragStatus</span>
                        <div class="composer-buttons">
                            <button class="secondary" @onclick="ResetRagAsync" disabled="@_ragBusy">Очистить</button>
                            <button class="primary" @onclick="SendRagAsync" disabled="@(_ragBusy || string.IsNullOrWhiteSpace(_ragQuestion) || !_ragControlsValid)">Отправить</button>
                        </div>
                    </div>
                </div>
                @if (_ragLast is not null)
                {
                    <article class="rag-answer">
                        <header>
                            <strong>@(_ragLast.Mode == RagMode.NoRag ? "Ответ без RAG" : _ragLast.Mode == RagMode.Enhanced ? "RAG-enhanced ответ" : "RAG-baseline ответ")</strong>
                            <span>
                                @if (_ragLast.Abstained)
                                {
                                    <span class="rag-check ok">@_ragLast.AbstentionReason</span>
                                }
                                else
                                {
                                    <span>@(_ragLast.SearchSucceeded ? $"Найдено {_ragLast.RetrievedCount}" : "Поиск не выполнен")</span>
                                }
                            </span>
                        </header>
                        <pre>@_ragLast.Answer</pre>
                        @if (_ragLast.Abstained && !string.IsNullOrWhiteSpace(_ragLast.ClarificationQuestion))
                        {
                            <div class="rag-error">@_ragLast.ClarificationQuestion</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_ragLast.Error))
                        {
                            <div class="rag-error">@_ragLast.Error</div>
                        }
                        @if (_ragLast.CitationsSafe.Count > 0)
                        {
                            <details class="rag-sources" open>
                                <summary>Цитаты (@_ragLast.CitationsSafe.Count, проверено @_ragLast.CitationsSafe.Count(c => c.Verified))</summary>
                                <ol>
                                    @foreach (var c in _ragLast.CitationsSafe)
                                    {
                                        <li>
                                            <div>
                                                <strong>@c.Reference</strong>
                                                <span class="rag-check @(c.Verified ? "ok" : "fail")">@(c.Verified ? "дословно" : "НЕ найдено")</span>
                                            </div>
                                            <small class="muted">section: @c.Section</small>
                                            <p style="white-space: pre-wrap;">@c.Quote</p>
                                        </li>
                                    }
                                </ol>
                            </details>
                        }
                        @if (_ragLast.Trace is not null)
                        {
                            <details class="rag-trace" open>
                                <summary>Журнал поиска</summary>
                                <ul class="rag-trace-list">
                                    <li>Оригинальный вопрос: <code>@_ragLast.Trace.OriginalQuestion</code></li>
                                    <li>Поисковый запрос: <code>@_ragLast.Trace.SearchQuery</code></li>
                                    <li>Pre-K / post-K: <code>@_ragLast.Trace.PreFilterCount → @_ragLast.Trace.PostFilterCount</code> (лимит post <code>@_ragLast.Trace.PostFilterLimit</code>)</li>
                                    <li>Threshold: <code>@_ragLast.Trace.Threshold.ToString("F4")</code></li>
                                    <li>Скор pre-filter: <code>@string.Join(", ", _ragLast.Trace.PreFilterScores.Select(s => s.ToString("F3")))</code></li>
                                    <li>Отклонено: <code>@_ragLast.Trace.Rejected.Count</code></li>
                                </ul>
                                @if (_ragLast.Trace.Rejected.Count > 0)
                                {
                                    <details><summary>Список отклонённых</summary>
                                        <ol>
                                            @foreach (var r in _ragLast.Trace.Rejected)
                                            {
                                                <li><code>@r.ChunkId</code> · score <code>@r.Score.ToString("F3")</code> · <span class="muted">@r.Reason</span></li>
                                            }
                                        </ol>
                                    </details>
                                }
                            </details>
                        }
                        @if (_ragLast.Sources.Count > 0)
                        {
                            <details class="rag-sources">
                                <summary>Источники (@_ragLast.Sources.Count)</summary>
                                <ol>
                                    @foreach (var source in _ragLast.Sources)
                                    {
                                        <li>
                                            <div><strong>@source.Title</strong> <span class="muted">@source.Source@(source.PdfPage is int p ? $" · стр. {p}" : "")</span> <span class="muted">score @source.Score.ToString("F3")</span></div>
                                            <small class="muted">@source.Section</small>
                                            <p>@source.Text</p>
                                        </li>
                                    }
                                </ol>
                            </details>
                        }
                    </article>
                }
                <article class="rag-autotest">
                    <header>
                        <div>
                            <strong>Автотест RAG</strong>
                            <p class="muted">«Обычный автотест» — legacy-прогон no-rag vs rag. «Сравнить режимы» — Day 23: no-rag, baseline и enhanced (rewrite + pre-K + threshold + post-K). «Тест День 24» — production-настройки с проверкой цитат и abstention «Не знаю». «Тест День 25» — два 10–15-репликовых сценария против RagMiniChatService: нормативы офиса (12) и серверы Revit (10) с проверкой цитат и abstain.</p>
                        </div>
                        <div class="rag-composer-actions">
                            <button class="secondary" @onclick="RunLegacyAutoTestAsync" disabled="@_ragBusy">Обычный автотест</button>
                            <button class="secondary" @onclick="RunCompareModesAsync" disabled="@_ragBusy">Сравнить режимы</button>
                            <button class="primary" @onclick="RunDay24TestAsync" disabled="@_ragBusy">Тест День 24</button>
                            <button class="primary" @onclick="RunDay25TestAsync" disabled="@(_ragBusy || _miniChatBusy)">Тест День 25</button>
                            @if (_autoTestCancellation is not null)
                            {
                                <button class="secondary" @onclick="CancelAutoTest">Остановить</button>
                            }
                        </div>
                    </header>
                    @if (_autoTestProgress.Count > 0)
                    {
                        <pre class="rag-progress">@string.Join("\n", _autoTestProgress)</pre>
                    }
                    @if (_autoTestAggregate is not null)
                    {
                        var agg = _autoTestAggregate;
                        <div class="rag-summary">
                            <span>Всего прогонов: <strong>@agg.Runs.Count</strong></span>
                            <span>С ошибкой: <strong>@agg.Runs.Count(r => r.Error is not null)</strong></span>
                            <span class="muted">Негативных кейсов: @agg.NegativeCases.Count</span>
                        </div>
                        <details class="rag-runs" open>
                            <summary>Сравнение режимов</summary>
                            <table class="rag-mode-table">
                                <thead><tr><th>Режим</th><th>Всего</th><th>Прошло</th><th>С ошибкой</th><th>Негативных</th><th>Негативных пройдено</th><th>Среднее источников</th></tr></thead>
                                <tbody>
                                @foreach (var a in agg.Aggregates)
                                {
                                    <tr>
                                        <td><strong>@a.Mode</strong></td>
                                        <td>@a.Total</td>
                                        <td>@a.Passed</td>
                                        <td>@a.WithErrors</td>
                                        <td>@a.NegativeTotal</td>
                                        <td>@a.NegativePassed</td>
                                        <td>@a.AverageRetrieved.ToString("F2")</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                            <p class="muted">Baseline: rewrite=@agg.Baseline.RewriteEnabled, pre-K=@agg.Baseline.PreFilterK, threshold=@agg.Baseline.ScoreThreshold.ToString("F3"), post-K=@agg.Baseline.PostFilterK</p>
                            @if (agg.Enhanced is not null)
                            {
                                <p class="muted">Enhanced: rewrite=@agg.Enhanced.RewriteEnabled, pre-K=@agg.Enhanced.PreFilterK, threshold=@agg.Enhanced.ScoreThreshold.ToString("F3"), post-K=@agg.Enhanced.PostFilterK</p>
                            }
                        </details>
                        @if (agg.NegativeCases.Count > 0)
                        {
                            <details class="rag-runs"><summary>Негативные кейсы (нет ожидаемых терминов)</summary>
                                <ol>
                                    @foreach (var n in agg.NegativeCases)
                                    {
                                        <li>
                                            <div><strong>#@n.Index · @n.Mode</strong> <span class="muted">@n.Question</span></div>
                                            <span class="rag-check @(n.Passed ? "ok" : "fail")">@(n.Passed ? "пройдено" : "провалено")</span>
                                            @if (!string.IsNullOrWhiteSpace(n.Error))
                                            {
                                                <span class="rag-check fail">ошибка: @n.Error</span>
                                            }
                                        </li>
                                    }
                                </ol>
                            </details>
                        }
                        @if (!string.IsNullOrWhiteSpace(agg.Error))
                        {
                            <div class="rag-error">@agg.Error</div>
                        }
                        <details class="rag-runs">
                            <summary>Результаты по вопросам</summary>
                            <ol>
                                @foreach (var run in agg.Runs)
                                {
                                    <li>
                                        <div>
                                            <strong>#@run.Index · @run.Mode</strong>
                                            <span class="muted">@run.Question</span>
                                        </div>
                                        <div class="rag-checks">
                                            <span class="rag-check @(run.FactCheckPassed ? "ok" : "fail")">термины: @(run.ExpectedFactTerms.Count == 0 ? "—" : $"{run.FoundFactTerms.Count}/{run.ExpectedFactTerms.Count}")</span>
                                            <span class="rag-check @(run.SourceCheckPassed ? "ok" : "fail")">источник: @run.ExpectedSource</span>
                                            <span class="rag-check @(run.SectionCheckPassed ? "ok" : "fail")">секция: @(run.ExpectedSectionContains ?? "—")</span>
                                            @if (run.IsNegativeCase) { <span class="rag-check ok">негативный</span> }
                                            @if (!string.IsNullOrWhiteSpace(run.Error)) { <span class="rag-check fail">ошибка: @run.Error</span> }
                                        </div>
                                        <pre>@run.Answer</pre>
                                        @if (run.Sources.Count > 0)
                                        {
                                            <details><summary>Источники (@run.Sources.Count)</summary>
                                                <ol>
                                                    @foreach (var s in run.Sources)
                                                    {
                                                        <li><strong>@s.Title</strong> <span class="muted">@s.Source@(s.PdfPage is int p ? $" · стр. {p}" : "")</span> <small class="muted">@s.Section</small> <span class="muted">score @s.Score.ToString("F3")</span></li>
                                                    }
                                                </ol>
                                            </details>
                                        }
                                    </li>
                                }
                            </ol>
                        </details>
                    }
                    @if (_autoTestReport is not null && _autoTestAggregate is null)
                    {
                        <!-- legacy view, если aggregate не построен (старый путь вызова) -->
                        <div class="rag-summary">
                            <span>Всего: <strong>@_autoTestReport.Total</strong></span>
                            <span>Прошло: <strong>@_autoTestReport.Passed</strong></span>
                            <span>С ошибкой: <strong>@_autoTestReport.WithErrors</strong></span>
                            <span class="muted">RAG-режим: @_autoTestReport.RagRuns.Count · No-RAG: @_autoTestReport.NoRagRuns.Count</span>
                        </div>
                    }
                    @if (_day24Report is not null)
                    {
                        var d24 = _day24Report;
                        <div class="rag-summary">
                            <span>Всего вопросов: <strong>@d24.Count</strong></span>
                            <span>С цитатами: <strong>@d24.Count(r => r.QuoteCheckPassed)</strong></span>
                            <span>Поддержанных: <strong>@d24.Count(r => r.AnswerSupportedByQuotes)</strong></span>
                            <span class="muted">«Не знаю»: @d24.Count(r => r.Abstained)</span>
                            <span class="muted">Без запрещённых токенов: @d24.Count(r => r.ForbiddenTermsCheckPassed)</span>
                        </div>
                        <details class="rag-runs" open>
                            <summary>Результаты по 10 вопросам (production-настройки)</summary>
                            <ol>
                                @foreach (var run in d24)
                                {
                                    <li>
                                        <div>
                                            <strong>#@run.Index · @run.Mode</strong>
                                            <span class="muted">@run.Question</span>
                                            @if (!string.IsNullOrWhiteSpace(run.ExpectedKind)) { <span class="rag-check ok">kind: @run.ExpectedKind</span> }
                                        </div>
                                        <div class="rag-checks">
                                            <span class="rag-check @(run.FactCheckPassed ? "ok" : "fail")">термины: @(run.ExpectedFactTerms.Count == 0 ? "—" : $"{run.FoundFactTerms.Count}/{run.ExpectedFactTerms.Count}")</span>
                                            <span class="rag-check @(run.SourceCheckPassed ? "ok" : "fail")">источник: @(string.IsNullOrEmpty(run.ExpectedSource) ? "—" : run.ExpectedSource)</span>
                                            <span class="rag-check @(run.SectionCheckPassed ? "ok" : "fail")">секция: @(run.ExpectedSectionContains ?? "—")</span>
                                            <span class="rag-check @(run.QuoteCheckPassed ? "ok" : "fail")">цитаты: @run.CitationsSafe.Count</span>
                                            <span class="rag-check @(run.AnswerSupportedByQuotes ? "ok" : "fail")">поддержано цитатами</span>
                                            <span class="rag-check @(run.ForbiddenTermsCheckPassed ? "ok" : "fail")">без запрещённых: @(run.ForbiddenTermsSafe.Count == 0 ? "—" : $"{run.ForbiddenTermsSafe.Count - run.FoundForbiddenTermsSafe.Count}/{run.ForbiddenTermsSafe.Count}")</span>
                                            @if (run.Abstained) { <span class="rag-check ok">abstain: @run.AbstentionReason</span> }
                                            @if (run.IsNegativeCase) { <span class="rag-check ok">негативный</span> }
                                            @if (!string.IsNullOrWhiteSpace(run.Error)) { <span class="rag-check fail">ошибка: @run.Error</span> }
                                        </div>
                                        <pre>@run.Answer</pre>
                                        @if (run.FoundForbiddenTermsSafe.Count > 0)
                                        {
                                            <div class="rag-error">Обнаружены запрещённые токены в ответе: @string.Join(", ", run.FoundForbiddenTermsSafe)</div>
                                        }
                                        @if (run.CitationsSafe.Count > 0)
                                        {
                                            <details><summary>Цитаты (@run.CitationsSafe.Count)</summary>
                                                <ol>
                                                    @foreach (var c in run.CitationsSafe)
                                                    {
                                                        <li>
                                                            <strong>@c.Reference</strong>
                                                            <span class="rag-check @(c.Verified ? "ok" : "fail")">@(c.Verified ? "дословно" : "НЕ найдено")</span>
                                                            <p style="white-space: pre-wrap;">@c.Quote</p>
                                                        </li>
                                                    }
                                                </ol>
                                            </details>
                                        }
                                        @if (run.Sources.Count > 0)
                                        {
                                            <details><summary>Источники (@run.Sources.Count)</summary>
                                                <ol>
                                                    @foreach (var s in run.Sources)
                                                    {
                                                        <li><strong>@s.Title</strong> <span class="muted">@s.Source@(s.PdfPage is int p ? $" · стр. {p}" : "")</span> <small class="muted">@s.Section</small> <span class="muted">score @s.Score.ToString("F3")</span> <code>@s.ChunkId</code></li>
                                                    }
                                                </ol>
                                            </details>
                                        }
                                    </li>
                                }
                            </ol>
                        </details>
                    }
                    @if (_day25Report is not null)
                    {
                        var d25 = _day25Report;
                        <div class="rag-summary">
                            <span class="rag-check @(d25.OverallPassed ? "ok" : "fail")"><strong>@(d25.OverallPassed ? "Тест День 25 пройден" : "Тест День 25 провален")</strong></span>
                            <span>Сценариев: <strong>@d25.ScenarioPassed/@d25.ScenarioTotal</strong></span>
                            <span>Шагов: <strong>@d25.StepPassed/@d25.StepTotal</strong></span>
                            <span class="muted">Ошибок: @d25.StepErrors</span>
                            <span class="muted">Abstain: @d25.StepAbstained</span>
                            <span class="muted">Длительность: @((int)d25.Duration.TotalSeconds) с</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(d25.Error))
                        {
                            <div class="rag-error">@d25.Error</div>
                        }
                        <details class="rag-runs" open>
                            <summary>Сценарии (День 25)</summary>
                            <ol>
                                @foreach (var scenario in d25.Scenarios)
                                {
                                    <li>
                                        <div>
                                            <strong>@scenario.ScenarioName</strong>
                                            <span class="muted">conversation: <code>@scenario.ConversationId</code></span>
                                        </div>
                                        <div class="rag-checks">
                                            <span class="rag-check @(scenario.Passed ? "ok" : "fail")">@(scenario.Passed ? "пройден" : "провален")</span>
                                            <span class="rag-check @(scenario.PassedSteps == scenario.TotalSteps ? "ok" : "fail")">шагов: @scenario.PassedSteps/@scenario.TotalSteps</span>
                                            <span class="muted">ошибок: @scenario.ErroredSteps</span>
                                            <span class="muted">abstain: @scenario.AbstainedSteps</span>
                                            <span class="muted">@((int)scenario.Duration.TotalSeconds) с</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(scenario.Error))
                                        {
                                            <div class="rag-error">@scenario.Error</div>
                                        }
                                        <details class="rag-trace" open>
                                            <summary>Goal / clarifications / terms (фактические из GetSession)</summary>
                                            <ul class="rag-trace-list">
                                                <li>Goal: <code>@scenario.CapturedGoal</code></li>
                                                <li>Clarifications (@scenario.CapturedClarifications.Count):
                                                    @if (scenario.CapturedClarifications.Count == 0) { <code>—</code> }
                                                    else
                                                    {
                                                        <ol>
                                                            @foreach (var c in scenario.CapturedClarifications) { <li><code>@c</code></li> }
                                                        </ol>
                                                    }
                                                </li>
                                                <li>Terms (@scenario.CapturedTerms.Count):
                                                    @if (scenario.CapturedTerms.Count == 0) { <code>—</code> }
                                                    else
                                                    {
                                                        <code>@string.Join(", ", scenario.CapturedTerms)</code>
                                                    }
                                                </li>
                                            </ul>
                                        </details>
                                        <details>
                                            <summary>Шаги (@scenario.Steps.Count)</summary>
                                            <ol>
                                                @foreach (var step in scenario.Steps)
                                                {
                                                    <li>
                                                        <div>
                                                            <strong>#@step.Index</strong>
                                                            <span class="muted">@step.Question</span>
                                                        </div>
                                                        <div class="rag-checks">
                                                            <span class="rag-check @(step.Passed ? "ok" : "fail")">@(step.Passed ? "ok" : "fail")</span>
                                                            @if (step.Question.StartsWith("Уточняю:", StringComparison.OrdinalIgnoreCase)) { <span class="rag-check ok">уточнение</span> }
                                                            else if (step.ExpectAbstain) { <span class="rag-check ok">ожидался abstain</span> }
                                                            @if (!string.IsNullOrEmpty(step.ExpectCitationChunk)) { <span class="muted">чанк: <code>@step.ExpectCitationChunk</code></span> }
                                                            <span class="muted">@step.ElapsedMs мс</span>
                                                        </div>
                                                        @if (!string.IsNullOrWhiteSpace(step.FailureReason))
                                                        {
                                                            <div class="rag-error">@step.FailureReason</div>
                                                        }
                                                        <pre>@step.Result.Answer</pre>
                                                        <details class="rag-sources" open="@(step.Result.Sources.Count > 0 || step.Result.CitationsSafe.Count > 0)">
                                                            <summary>Источники (@step.Result.Sources.Count) · цитаты (@step.Result.CitationsSafe.Count)</summary>
                                                            @if (step.Result.CitationsSafe.Count == 0 && step.Result.Sources.Count == 0)
                                                            {
                                                                <p class="muted">Источников нет.</p>
                                                            }
                                                            @if (step.Result.CitationsSafe.Count > 0)
                                                            {
                                                                <ol>
                                                                    @foreach (var c in step.Result.CitationsSafe)
                                                                    {
                                                                        <li>
                                                                            <strong>@c.Reference</strong>
                                                                            <span class="rag-check @(c.Verified ? "ok" : "fail")">@(c.Verified ? "дословно" : "НЕ найдено")</span>
                                                                            <p style="white-space: pre-wrap;">@c.Quote</p>
                                                                        </li>
                                                                    }
                                                                </ol>
                                                            }
                                                            @if (step.Result.Sources.Count > 0)
                                                            {
                                                                <details>
                                                                    <summary>Все источники (@step.Result.Sources.Count)</summary>
                                                                    <ol>
                                                                        @foreach (var src in step.Result.Sources)
                                                                        {
                                                                            <li>
                                                                                <div><strong>@src.Title</strong> <span class="muted">@src.Source@(src.PdfPage is int p ? $" · стр. {p}" : "")</span> <span class="muted">score @src.Score.ToString("F3")</span></div>
                                                                                <small class="muted">@src.Section</small>
                                                                                <p>@src.Text</p>
                                                                            </li>
                                                                        }
                                                                    </ol>
                                                                </details>
                                                            }
                                                        </details>
                                                    </li>
                                                }
                                            </ol>
                                        </details>
                                    </li>
                                }
                            </ol>
                        </details>
                    }
                </article>
            </section>
        }
        else if (_section == "minichat")
        {
            <header class="workspace-header">
                <div>
                    <h1>Mini-чат (День 25)</h1>
                    <p>Беседа на каждую тему с целью, уточнениями и терминами. Полная история реплик сохраняется, в контекст уходит окно последних 6 реплик.</p>
                </div>
                <div class="rag-composer-actions">
                    <span class="rag-status">@_miniChatStatus</span>
                    <div class="composer-buttons">
                        <button class="secondary" @onclick="ResetMiniChatAsync" disabled="@_miniChatBusy">Новая беседа</button>
                        <button class="primary" @onclick="SendMiniChatAsync" disabled="@(_miniChatBusy || string.IsNullOrWhiteSpace(_miniChatQuestion))">Отправить</button>
                    </div>
                </div>
            </header>
            <section class="minichat-layout">
                <aside class="minichat-state">
                    <div class="minichat-state-block">
                        <label>Цель беседы</label>
                        <textarea @bind="_miniChatGoal" @bind:event="oninput" rows="3" placeholder="Например: собрать нормативные требования к офису" disabled="@_miniChatBusy"></textarea>
                        <button class="secondary" @onclick="SaveMiniChatGoalAsync" disabled="@_miniChatBusy">Сохранить цель</button>
                    </div>
                    <div class="minichat-state-block">
                        <label>Уточнения</label>
                        @if (_miniChatSession is null || _miniChatSession.State.Clarifications.Count == 0)
                        {
                            <p class="muted">Пока нет уточнений.</p>
                        }
                        else
                        {
                            <ul class="minichat-list">
                                @for (var i = 0; i < _miniChatSession.State.Clarifications.Count; i++)
                                {
                                    var index = i;
                                    <li>
                                        <span>@_miniChatSession.State.Clarifications[index]</span>
                                        <button class="secondary minichat-remove" title="Удалить уточнение" aria-label="Удалить уточнение" @onclick="() => RemoveMiniChatClarificationAsync(index)" disabled="@_miniChatBusy">×</button>
                                    </li>
                                }
                            </ul>
                        }
                        <div class="minichat-add">
                            <input @bind="_miniChatNewClarification" placeholder="Новое уточнение" disabled="@_miniChatBusy" />
                            <button class="secondary minichat-add-button" title="Добавить уточнение" aria-label="Добавить уточнение" @onclick="AddMiniChatClarificationAsync" disabled="@(_miniChatBusy || string.IsNullOrWhiteSpace(_miniChatNewClarification))">+</button>
                        </div>
                    </div>
                    <div class="minichat-state-block">
                        <label>Термины / ограничения</label>
                        @if (_miniChatSession is null || _miniChatSession.State.Terms.Count == 0)
                        {
                            <p class="muted">Пока нет терминов.</p>
                        }
                        else
                        {
                            <ul class="minichat-list">
                                @for (var i = 0; i < _miniChatSession.State.Terms.Count; i++)
                                {
                                    var index = i;
                                    <li>
                                        <span>@_miniChatSession.State.Terms[index]</span>
                                        <button class="secondary minichat-remove" title="Удалить термин" aria-label="Удалить термин" @onclick="() => RemoveMiniChatTermAsync(index)" disabled="@_miniChatBusy">×</button>
                                    </li>
                                }
                            </ul>
                        }
                        <div class="minichat-add">
                            <input @bind="_miniChatNewTerm" placeholder="Через запятую или по одному" disabled="@_miniChatBusy" />
                            <button class="secondary minichat-add-button" title="Добавить термин" aria-label="Добавить термин" @onclick="AddMiniChatTermsAsync" disabled="@(_miniChatBusy || string.IsNullOrWhiteSpace(_miniChatNewTerm))">+</button>
                        </div>
                    </div>
                </aside>
                <article class="minichat-transcript">
                    <header>
                        <strong>Транскрипт беседы</strong>
                        <span class="muted">@_miniChatConversationId · @(_miniChatSession?.TurnCount ?? 0) реплик</span>
                    </header>
                    @if (_miniChatSession is null || _miniChatSession.TurnCount == 0)
                    {
                        <div class="minichat-empty">
                            <h2>Начните диалог</h2>
                            <p>Задайте вопрос ниже — сервис покажет ответ с цитатами и сразу же сохранит реплику в историю.</p>
                        </div>
                    }
                    @foreach (var turn in _miniChatSession?.Turns ?? Array.Empty<RagMiniChatTurn>())
                    {
                        <article class="minichat-message @MiniChatOutcomeClass(turn)">
                            <header>
                                <strong>Вы</strong>
                                <span class="muted">@turn.AskedAt.LocalDateTime:g</span>
                            </header>
                            <p class="minichat-question">@turn.UserQuestion</p>
                            <header>
                                <strong>Ассистент · @turn.Result.ModeLabel</strong>
                                <span class="muted">
                                    @if (turn.Result.Abstained)
                                    {
                                        <span class="rag-check ok">abstain: @turn.Result.AbstentionReason</span>
                                    }
                                    else
                                    {
                                        <span>@(turn.Result.SearchSucceeded ? $"Найдено {turn.Result.RetrievedCount}" : "Поиск не выполнен")</span>
                                    }
                                </span>
                            </header>
                            <pre>@turn.Result.Answer</pre>
                            @if (turn.Result.Abstained && !string.IsNullOrWhiteSpace(turn.Result.ClarificationQuestion))
                            {
                                <div class="rag-error">@turn.Result.ClarificationQuestion</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(turn.Result.Error))
                            {
                                <div class="rag-error">@turn.Result.Error</div>
                            }
                            <details class="rag-sources" open>
                                <summary>Источники (@turn.Result.Sources.Count) · цитаты (@turn.Result.CitationsSafe.Count)</summary>
                                @if (turn.Result.Sources.Count == 0 && turn.Result.CitationsSafe.Count == 0)
                                {
                                    <p class="muted">@(turn.Result.Answer.StartsWith("Принял уточнение", StringComparison.Ordinal) ? "Уточнение сохранено; источники для изменения настроек беседы не требуются." : "Источников нет — модель воздержалась от ответа или поиск не дал кандидатов.")</p>
                                }
                                @if (turn.Result.CitationsSafe.Count > 0)
                                {
                                    <ol>
                                        @foreach (var c in turn.Result.CitationsSafe)
                                        {
                                            <li>
                                                <div>
                                                    <strong>@c.Reference</strong>
                                                    <span class="rag-check @(c.Verified ? "ok" : "fail")">@(c.Verified ? "дословно" : "НЕ найдено")</span>
                                                </div>
                                                <small class="muted">section: @c.Section</small>
                                                <p style="white-space: pre-wrap;">@c.Quote</p>
                                            </li>
                                        }
                                    </ol>
                                }
                                @if (turn.Result.Sources.Count > 0)
                                {
                                    <details>
                                        <summary>Все источники (@turn.Result.Sources.Count)</summary>
                                        <ol>
                                            @foreach (var source in turn.Result.Sources)
                                            {
                                                <li>
                                                    <div><strong>@source.Title</strong> <span class="muted">@source.Source@(source.PdfPage is int p ? $" · стр. {p}" : "")</span> <span class="muted">score @source.Score.ToString("F3")</span></div>
                                                    <small class="muted">@source.Section</small>
                                                    <p>@source.Text</p>
                                                </li>
                                            }
                                        </ol>
                                    </details>
                                }
                            </details>
                        </article>
                    }
                    @if (_miniChatBusy) { <div class="thinking">Ассистент анализирует запрос…</div> }
                </article>
                <footer class="minichat-composer">
                    <textarea @bind="_miniChatQuestion" @bind:event="oninput" @onkeydown="OnMiniChatKeyDownAsync" rows="2" placeholder="Вопрос по локальной базе знаний · Ctrl+Enter — отправить" disabled="@_miniChatBusy"></textarea>
                </footer>
            </section>
        }
        else if (_section == "profiles")
        {
            <header class="workspace-header"><div><h1>Профили</h1><p>Стиль, инструменты и контекст каждого режима работы</p></div><button class="primary" @onclick="NewProfile">Создать профиль</button></header>
            <section class="split-view">
                <div class="item-list">
                    @if (_profiles.Count == 0) { <p class="muted">Профили ещё не созданы.</p> }
                    @foreach (var profile in _profiles)
                    {
                        <button class="list-item @(profile.Name == _editingProfile?.Name ? "selected" : "")" @onclick="() => EditProfile(profile)">
                            <strong>@profile.Name</strong><span>@(profile.Name == _activeProfile?.Name ? "Активный" : "Выбрать и настроить")</span>
                        </button>
                    }
                </div>
                <EditForm Model="_profileDraft" OnValidSubmit="SaveProfileAsync" class="editor-form">
                    <h2>@(_isNewProfile ? "Новый профиль" : "Настройка профиля")</h2>
                    <label>Имя<input @bind="_profileDraft.Name" disabled="@(!_isNewProfile)" /></label>
                    <label>Style<textarea @bind="_profileDraft.Style" rows="5" placeholder="Например: отвечай кратко, используй русский язык..."></textarea></label>
                    <label>Constraints / Tooling<textarea @bind="_profileDraft.ConstraintsAndTooling" rows="6" placeholder="Стек, инструменты, ограничения и правила..."></textarea></label>
                    <label>Context<textarea @bind="_profileDraft.Context" rows="6" placeholder="Роль, текущий проект и другой полезный контекст..."></textarea></label>
                    <div class="form-actions">
                        @if (!_isNewProfile && _editingProfile is not null)
                        {
                            <button type="button" class="danger" @onclick="DeleteProfileAsync">Удалить</button>
                            @if (_editingProfile.Name != _activeProfile?.Name) { <button type="button" class="secondary" @onclick="SelectEditingProfileAsync">Выбрать</button> }
                        }
                        <button type="submit" class="primary">Сохранить и выбрать</button>
                    </div>
                </EditForm>
            </section>
        }
        else if (_section == "prompt")
        {
            <header class="workspace-header"><div><h1>Базовый prompt</h1><p>Системная инструкция перед профилем и памятью</p></div><span class="readonly-badge">Только чтение</span></header>
            <section class="prompt-view">
                <textarea readonly aria-label="Базовый системный prompt">@DesignerAssistantPrompt.Text</textarea>
            </section>
        }
        else if (_section == "invariants")
        {
            <header class="workspace-header"><div><h1>Инварианты</h1><p>Глобальные правила с наивысшим приоритетом</p></div><button class="primary" @onclick="SaveInvariantsAsync" disabled="@_busy">Сохранить</button></header>
            <section class="invariants-view">
                <textarea @bind="_invariants" @bind:event="oninput" aria-label="Глобальные инварианты" placeholder="Введите правила, которые ассистент не имеет права нарушать"></textarea>
            </section>
        }
        else if (_section == "memory")
        {
            <header class="workspace-header"><div><h1>Память</h1><p>Данные, которые агент добавляет в контекст</p></div><button class="secondary" @onclick="CompleteTaskAsync">Завершить задачу</button></header>
            <section class="memory-grid">
                <div><h2>Краткосрочная</h2><strong>@(_memory?.ShortTerm.Count ?? 0)</strong><p>сообщений текущего диалога</p></div>
                <div><h2>Рабочая</h2>@foreach (var entry in _memory?.Working ?? []) { <article><strong>@entry.Key</strong><p>@entry.Value</p></article> }</div>
                <div><h2>Долговременная</h2>@foreach (var entry in _memory?.LongTerm ?? []) { <article><strong>@entry.Key</strong><p>@entry.Value</p></article> }</div>
            </section>
        }
        else if (_section == "scheduled")
        {
            <header class="workspace-header">
                <div><h1>Периодические задачи</h1><p>Агент запускает активные задачи, пока работает BIM Assistant</p></div>
                <button class="primary" @onclick="NewScheduledTask">Добавить задачу</button>
            </header>
            <section class="schedule-layout">
                <div class="schedule-list">
                    @if (_scheduledTasks.Count == 0)
                    {
                        <div class="schedule-empty"><h2>Расписание пусто</h2><p>Создайте первую задачу для автоматического запуска.</p></div>
                    }
                    @foreach (var task in _scheduledTasks)
                    {
                        <article class="schedule-item @(task.Id == _scheduledDraft.Id ? "selected" : "")">
                            <button class="schedule-summary" @onclick="() => EditScheduledTask(task)">
                                <span class="schedule-state @(task.IsEnabled ? "enabled" : "")"></span>
                                <span><strong>@task.Name</strong><small>@ScheduleDescription(task)</small></span>
                            </button>
                            <div class="schedule-meta">
                                <span>@(task.IsRunning ? "Выполняется" : task.IsEnabled ? $"Следующий запуск: {task.NextRunAt.LocalDateTime:g}" : "Отключена")</span>
                                @if (task.LastRunAt is not null) { <span>Последний: @task.LastRunAt.Value.LocalDateTime:g</span> }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(task.LastResult))
                            {
                                <details><summary>Результат последнего запуска</summary><p>@task.LastResult</p></details>
                            }
                            <div class="schedule-actions">
                                <button class="secondary" title="Запустить сейчас" disabled="@task.IsRunning" @onclick="() => RunScheduledTaskAsync(task.Id)">Запустить</button>
                                <button class="secondary" @onclick="() => ToggleScheduledTaskAsync(task)">@(task.IsEnabled ? "Отключить" : "Включить")</button>
                            </div>
                        </article>
                    }
                </div>
                <EditForm Model="_scheduledDraft" OnValidSubmit="SaveScheduledTaskAsync" class="schedule-editor">
                    <h2>@(_scheduledIsNew ? "Новая задача" : "Настройка задачи")</h2>
                    <label>Название<input @bind="_scheduledDraft.Name" placeholder="Например: Ежедневная проверка модели" /></label>
                    <label>Задача для агента<textarea @bind="_scheduledDraft.Prompt" rows="7" placeholder="Опишите, что агент должен выполнить"></textarea></label>
                    <div class="schedule-fields">
                        <label>Период
                            <select @bind="_scheduledDraft.Period">
                                <option value="@SchedulePeriod.Daily">Каждый день</option>
                                <option value="@SchedulePeriod.Weekly">Каждую неделю</option>
                                <option value="@SchedulePeriod.Monthly">Каждый месяц</option>
                            </select>
                        </label>
                        <label>Время<input type="time" value="@_scheduledDraft.TimeText" @onchange="OnScheduleTimeChanged" /></label>
                        @if (_scheduledDraft.Period == SchedulePeriod.Weekly)
                        {
                            <label>День недели
                                <select @bind="_scheduledDraft.DayOfWeek">
                                    <option value="@DayOfWeek.Monday">Понедельник</option><option value="@DayOfWeek.Tuesday">Вторник</option>
                                    <option value="@DayOfWeek.Wednesday">Среда</option><option value="@DayOfWeek.Thursday">Четверг</option>
                                    <option value="@DayOfWeek.Friday">Пятница</option><option value="@DayOfWeek.Saturday">Суббота</option>
                                    <option value="@DayOfWeek.Sunday">Воскресенье</option>
                                </select>
                            </label>
                        }
                        @if (_scheduledDraft.Period == SchedulePeriod.Monthly)
                        {
                            <label>День месяца<input type="number" min="1" max="31" @bind="_scheduledDraft.DayOfMonth" /></label>
                        }
                    </div>
                    <label class="toggle-row"><input type="checkbox" @bind="_scheduledDraft.IsEnabled" /> Задача активна</label>
                    <label class="toggle-row"><input type="checkbox" @bind="_scheduledDraft.AutoApproveRevitChanges" /> Автоматически разрешать запросы Revit</label>
                    <label>Таймаут операции Revit, мин.<input type="number" min="1" max="120" @bind="_scheduledDraft.OperationTimeoutMinutes" /></label>
                    <label>Версия Revit
                        <select @bind="_scheduledDraft.RevitTargetYear">
