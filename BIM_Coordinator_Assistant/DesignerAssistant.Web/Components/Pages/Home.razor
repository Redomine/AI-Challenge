    private async Task UpdateTaskMetricsAsync()
    {
        var response = Session.LastTaskResponse;
        if (response is null || Session.CurrentTask is null) return;
        _lastToolTraces = response.ToolTraces ?? [];
        _lastUsage = $"Этап: {Session.CurrentTask.State}; отправлено ≈{response.SentHistoryTokens:N0} токенов";
        if (response.ModelResponse.FinishReason == "task_state_validation_error")
            await Session.AppendErrorAsync(response.ModelResponse.Content);
    }

    private string TaskStageClass(TaskState state)
    {
        var current = Session.CurrentTask?.State;
        if (current is null) return "";
        var visibleCurrent = current switch
        {
            TaskState.AwaitingPlanApproval or TaskState.Clarification when Session.CurrentTask?.Clarification?.ResumeState != TaskState.Execution => TaskState.Planning,
            TaskState.PlanningInterrupted => TaskState.Planning,
            TaskState.AwaitingContinuation => Session.CurrentTask?.ResumeState == TaskState.Done ? TaskState.Validation : TaskState.Execution,
            TaskState.ExecutionInterrupted => TaskState.Execution,
            TaskState.AwaitingValidationDecision => TaskState.Validation,
            TaskState.Cancelled or TaskState.Failed => (TaskState?)null,
            _ => current
        };
        if (state == visibleCurrent) return "current";
        return visibleCurrent is not null && state < visibleCurrent ? "complete" : "";
    }

    private static string TaskStageCaption(TaskState state) => state switch
    {
        TaskState.Planning => "План",
        TaskState.PlanningInterrupted => "Планирование прервано",
        TaskState.AwaitingPlanApproval => "Согласование",
        TaskState.Execution => "Выполнение",
        TaskState.Clarification => "Уточнение",
        TaskState.Validation => "Проверка",
        TaskState.AwaitingValidationDecision => "Требуется решение",
        TaskState.AwaitingContinuation => "Пауза",
        TaskState.Done => "Готово",
        TaskState.Cancelled => "Отменено",
        TaskState.Failed => "Ошибка",
        TaskState.ExecutionInterrupted => "Выполнение прервано",
        _ => ""
    };

    private static string MessageLabel(ChatMessage message) => message.Role == "user"
        ? "Вы"
        : message.Stage switch
        {
            TaskState.Planning => "Ассистент · Планирование",
            TaskState.AwaitingPlanApproval => "Ассистент · План",
            TaskState.Execution => "Ассистент · Выполнение",
            TaskState.Clarification => "Ассистент · Уточнение",
            TaskState.Validation => "Ассистент · Валидация",
            TaskState.Done => "Ассистент · Итог",
            TaskState.Failed => "Ассистент · Ошибка",
            _ => "Ассистент"
        };

    private static bool IsCollapsibleStageMessage(ChatMessage message) =>
        message.Role == "assistant" && message.Stage is TaskState.Planning or TaskState.Execution;

    private bool ShouldExpandStageMessage(ChatMessage message) =>
        message.Stage == TaskState.Planning &&
        Session.AwaitingPlanApproval &&
        message == Session.History.LastOrDefault(item => item.Role == "assistant" && item.Stage == TaskState.Planning);

