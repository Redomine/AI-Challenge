    {
        if (string.IsNullOrWhiteSpace(_profileDraft.Name)) { _notice = "Укажите имя профиля."; return; }
        if (_isNewProfile && _profiles.Any(p => p.Name.Equals(_profileDraft.Name, StringComparison.OrdinalIgnoreCase))) { _notice = "Профиль с таким именем уже существует."; return; }
        await Session.SaveProfileAsync(_profileDraft.ToProfile());
        await ReloadProfilesAsync(); _notice = "Профиль сохранён и выбран.";
    }

    private async Task SelectEditingProfileAsync() { if (_editingProfile is null) return; await Session.SelectProfileAsync(_editingProfile.Name); await ReloadProfilesAsync(); _notice = "Профиль выбран."; }
    private async Task DeleteProfileAsync() { if (_editingProfile is null) return; await Session.SelectProfileAsync(_editingProfile.Name); await Session.DeleteProfileAsync(); NewProfile(); await ReloadProfilesAsync(); _notice = "Профиль удалён."; }
    private async Task ReloadProfilesAsync() { _profiles = await Session.GetProfilesAsync(); _activeProfile = await Session.GetProfileAsync(); if (_editingProfile is null && _profiles.Count > 0) EditProfile(_activeProfile ?? _profiles[0]); }
    private async Task SelectRevitAsync(RevitSession session) { _notice = await Session.SelectRevitSessionAsync(session.ProcessId.ToString()); }
    private void ResolveTransaction(bool approved) => Session.ResolveTransaction(approved);
    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);
    private void NewScheduledTask() { _scheduledIsNew = true; _scheduledDraft = new(); }
    private void EditScheduledTask(ScheduledAgentTask task) { _scheduledIsNew = false; _scheduledDraft = ScheduledTaskDraft.From(task); }
    private async Task SaveScheduledTaskAsync()
    {
        try { await Scheduler.SaveAsync(_scheduledDraft.ToTask()); await ReloadScheduledTasksAsync(); _notice = "Расписание сохранено."; }
        catch (Exception exception) { _notice = exception.Message; }
    }
    private async Task DeleteScheduledTaskAsync() { await Scheduler.DeleteAsync(_scheduledDraft.Id); NewScheduledTask(); await ReloadScheduledTasksAsync(); _notice = "Задача удалена."; }
    private async Task ToggleScheduledTaskAsync(ScheduledAgentTask task) { await Scheduler.SaveAsync(task with { IsEnabled = !task.IsEnabled }); await ReloadScheduledTasksAsync(); }
    private async Task RunScheduledTaskAsync(Guid id) { _notice = "Задача запущена."; _ = Scheduler.RunNowAsync(id); await Task.Delay(50); await ReloadScheduledTasksAsync(); }
    private async Task ReloadScheduledTasksAsync() => _scheduledTasks = await Scheduler.GetTasksAsync();
    private void OnScheduleTimeChanged(ChangeEventArgs args) => _scheduledDraft.TimeText = args.Value?.ToString() ?? "09:00";
    private static string ScheduleDescription(ScheduledAgentTask task) => task.Period switch
    {
        SchedulePeriod.Daily => $"Каждый день в {task.Time:HH\\:mm}",
        SchedulePeriod.Weekly => $"{WeekdayName(task.DayOfWeek ?? DayOfWeek.Monday)}, {task.Time:HH\\:mm}",
        SchedulePeriod.Monthly => $"{task.DayOfMonth ?? 1}-го числа в {task.Time:HH\\:mm}",
        _ => ""
    };
    private static string WeekdayName(DayOfWeek day) => day switch { DayOfWeek.Monday => "Каждый понедельник", DayOfWeek.Tuesday => "Каждый вторник", DayOfWeek.Wednesday => "Каждую среду", DayOfWeek.Thursday => "Каждый четверг", DayOfWeek.Friday => "Каждую пятницу", DayOfWeek.Saturday => "Каждую субботу", _ => "Каждое воскресенье" };
    private async void OnSchedulerChanged() { if (_section == "scheduled") { await InvokeAsync(async () => { await ReloadScheduledTasksAsync(); StateHasChanged(); }); } }
    public void Dispose() { Session.Changed -= OnSessionChanged; Scheduler.Changed -= OnSchedulerChanged; }

    private sealed class UserProfileDraft
    {
        public string Name { get; set; } = "";
        public string Style { get; set; } = "";
        public string ConstraintsAndTooling { get; set; } = "";
        public string Context { get; set; } = "";
        public UserProfile ToProfile() => new(Name.Trim(), Style.Trim(), ConstraintsAndTooling.Trim(), Context.Trim());
        public static UserProfileDraft From(UserProfile profile) => new() { Name = profile.Name, Style = profile.Style, ConstraintsAndTooling = profile.ConstraintsAndTooling, Context = profile.Context };
    }

    private sealed class ScheduledTaskDraft
    {
        public Guid Id { get; set; } = Guid.NewGuid();
        public string Name { get; set; } = "";
        public string Prompt { get; set; } = "";
        public SchedulePeriod Period { get; set; } = SchedulePeriod.Daily;
        public string TimeText { get; set; } = "09:00";
        public DayOfWeek DayOfWeek { get; set; } = DayOfWeek.Monday;
        public int DayOfMonth { get; set; } = 1;
        public bool IsEnabled { get; set; } = true;
        public bool AutoApproveRevitChanges { get; set; }
        public int OperationTimeoutMinutes { get; set; } = 10;
        public int? RevitTargetYear { get; set; }
        public bool NotifyOnSuccess { get; set; }
        public ScheduledAgentTask ToTask()
        {
            if (!TimeOnly.TryParse(TimeText, out var time)) throw new InvalidOperationException("Укажите корректное время запуска.");
            return new(Id, Name, Prompt, Period, time, DayOfWeek, DayOfMonth, IsEnabled, DateTimeOffset.Now,
                AutoApproveRevitChanges: AutoApproveRevitChanges,
                OperationTimeoutMinutes: Math.Clamp(OperationTimeoutMinutes, 1, 120),
                RevitTargetYear: RevitTargetYear,
                NotifyOnSuccess: NotifyOnSuccess);
        }
        public static ScheduledTaskDraft From(ScheduledAgentTask task) => new() { Id = task.Id, Name = task.Name, Prompt = task.Prompt, Period = task.Period, TimeText = task.Time.ToString("HH:mm"), DayOfWeek = task.DayOfWeek ?? DayOfWeek.Monday, DayOfMonth = task.DayOfMonth ?? 1, IsEnabled = task.IsEnabled, AutoApproveRevitChanges = task.AutoApproveRevitChanges, OperationTimeoutMinutes = task.OperationTimeoutMinutes, RevitTargetYear = task.RevitTargetYear, NotifyOnSuccess = task.NotifyOnSuccess };
    }
}
