                enhancedSettings = RagQuery.Options.ToEnhancedSettings();
            }
            _autoTestAggregate = await AutoTest.RunAggregateAsync(
                cases,
                baseline: baselineSettings,
                enhanced: enhancedSettings,
                includeNoRag: true,
                progress: progress,
                cancellationToken: _autoTestCancellation.Token);
            if (_autoTestAggregate.Error is not null)
            {
                _autoTestProgress.Add($"Ошибка: {_autoTestAggregate.Error}");
            }
            else
            {
                var passedTotal = _autoTestAggregate.Aggregates.Sum(a => a.Passed);
