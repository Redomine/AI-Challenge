        // (RagMode.Rag) без no-rag и без comparison-baseline. UI показывает
        // статусы цитирования и поддержки ответа.
        // Загружает dedicated набор questions-day24.json (10 вопросов:
        // STLB-OK1, neighbour-колонки, no-evidence, ambiguity, KB-positive).
        _ragBusy = true;
        _autoTestCancellation = new CancellationTokenSource();
        _autoTestProgress = new List<string> { "Загружаю контрольные вопросы..." };
        _autoTestReport = null;
        _autoTestAggregate = null;
        _ragStatus = "Тест День 24 запущен";
        try
        {
            IReadOnlyList<AutoTestCase> cases;
            try
            {
                cases = await AutoTest.LoadCasesAsync(_autoTestCancellation.Token);
            }
            catch (Exception loadEx)
            {
                _notice = $"Не удалось загрузить контрольные вопросы: {loadEx.Message}";
                _ragBusy = false;
                return;
            }
            _autoTestProgress.Clear();
            _autoTestProgress.Add($"Загружено {cases.Count} вопросов ({(AutoTest.IsDay24Set() ? "Day 24 dedicated set" : "legacy set")})");
            var progress = new Progress<string>(line =>
            {
                _autoTestProgress.Add(line);
                _ = InvokeAsync(StateHasChanged);
            });
            var productionSettings = RagQuery.Options.ToProductionSettings();
            var aggregate = await AutoTest.RunAggregateAsync(
                cases,
                baseline: productionSettings,
                enhanced: null,
                includeNoRag: false,
                progress: progress,
                cancellationToken: _autoTestCancellation.Token);
            // Оставляем только production-режим: переименовываем baseline → production.
            _day24Report = aggregate.Runs
                .Select(r => r.Mode == "baseline" ? r with { Mode = "production" } : r)
                .ToArray();
            _autoTestProgress.Add($"Завершено: {_day24Report.Count(r => r.QuoteCheckPassed)}/{_day24Report.Count} с цитатами, {_day24Report.Count(r => r.Abstained)} abstentions, {_day24Report.Count(r => r.ForbiddenTermsCheckPassed)} без запрещённых токенов");
            _ragStatus = "Тест День 24 завершён";
        }
        catch (Exception exception)
        {
            _notice = exception.Message;
            _ragStatus = "Ошибка теста День 24";
        }
        finally
        {
            _ragBusy = false;
            _autoTestCancellation?.Dispose();
            _autoTestCancellation = null;
        }
    }
