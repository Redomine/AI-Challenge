@page "/"
@implements IDisposable
@inject AssistantSession Session
@inject IWebHostEnvironment Environment

<PageTitle>BIM Assistant</PageTitle>

<div class="app-shell">
    <aside class="sidebar">
        <header class="brand">
            <span class="brand-mark">BA</span>
            <div><strong>BIM Assistant</strong><small>Координация и поддержка</small></div>
        </header>

        <nav class="primary-nav" aria-label="Разделы">
            <button class="@NavClass("chat")" @onclick='@(() => OpenSection("chat"))'>Чат</button>
            <button class="@NavClass("profiles")" @onclick="OpenProfilesAsync">Профили</button>
            <button class="@NavClass("prompt")" @onclick='@(() => OpenSection("prompt"))'>Базовый prompt</button>
            <button class="@NavClass("invariants")" @onclick="OpenInvariantsAsync">Инварианты</button>
            <button class="@NavClass("memory")" @onclick="OpenMemoryAsync">Память</button>
            <button class="@NavClass("revit")" @onclick="OpenRevitAsync">Revit</button>
        </nav>

        <div class="sidebar-status">
            <span class="status-dot @(_ready ? "online" : "")"></span>
            <div><strong>@(_ready ? "Агент готов" : "Подключение")</strong><small>@(_activeProfile?.Name ?? "Без профиля")</small></div>
        </div>
    </aside>

    <main class="workspace @(_section == "chat" ? "chat-workspace" : "")">
        @if (!_ready)
        {
            <section class="empty-state"><h1>BIM Assistant</h1><p>@(_error ?? "Подготавливаю рабочую сессию...")</p></section>
        }
        else if (_section == "chat")
        {
            <header class="workspace-header">
                <div><h1>Диалог</h1><p>Профиль: @(_activeProfile?.Name ?? "не выбран")</p></div>
                <button class="secondary" @onclick="ClearHistoryAsync" disabled="@_busy">Очистить диалог</button>
            </header>
            <section class="task-flow" aria-label="Этапы задачи">
                @foreach (var state in PrimaryTaskStages)
                {
                    <div class="task-stage @TaskStageClass(state)"><strong>@state</strong><span>@TaskStageCaption(state)</span></div>
                }
                <div class="pause-settings">
                    <label><input type="checkbox" checked disabled /> После Planning</label>
                    <label><input type="checkbox" @bind="_pauseAfterExecution" disabled="@TaskIsActive" /> После Execution</label>
                    <label><input type="checkbox" @bind="_pauseAfterValidation" disabled="@TaskIsActive" /> После Validation</label>
                </div>
            </section>
            <section class="chat-log @(Session.History.Count == 0 ? "empty" : "")" aria-live="polite">
                @if (Session.History.Count == 0)
                {
                    <div class="empty-chat"><h2>Новый диалог</h2><p>Опишите задачу по модели, плагину или скрипту.</p></div>
                }
                @foreach (var message in Session.History)
                {
                    <article class="message @message.Role">
                        @if (IsCollapsibleStageMessage(message))
                        {
                            <details class="stage-message" open="@ShouldExpandStageMessage(message)">
                                <summary>@MessageLabel(message)</summary>
                                <p>@message.Content</p>
                            </details>
                        }
                        else
                        {
                            <span>@MessageLabel(message)</span>
                            <p>@message.Content</p>
                        }
                    </article>
                }
                @if (_busy) { <div class="thinking">Ассистент анализирует запрос...</div> }
            </section>
            <footer class="composer">
                @if (Session.PlanningInterrupted && Session.CurrentTask is not null)
                {
                    <section class="validation-recovery" role="alert">
                        <strong>Планирование прервано</strong>
                        <details open><summary>Причина</summary><pre>@Session.CurrentTask.FailureReason</pre></details>
                        <div>
                            <button class="secondary" @onclick="RetryPlanningAsync" disabled="@_busy">Повторить</button>
                            <button class="secondary" @onclick="SendAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_message))">Отправить уточнение</button>
                            <button class="danger" @onclick="CancelTask" disabled="@_busy">Отменить</button>
                        </div>
                    </section>
                }
                @if (Session.ValidationFailed && Session.CurrentTask is not null)
                {
                    <section class="validation-recovery" role="alert">
                        <strong>Валидация не завершена</strong>
                        <details open><summary>Детали ошибки</summary><pre>@Session.CurrentTask.ValidationResult</pre></details>
                        <div>
                            <button class="secondary" @onclick="RetryValidationAsync" disabled="@_busy">Повторить валидацию</button>
                            @if (Session.CurrentTask.ExecutionRetrySafe)
                            {
                                <button class="secondary" @onclick="RetryExecutionAsync" disabled="@_busy">Повторить выполнение</button>
                            }
                            <button class="secondary" @onclick="ReplanAsync" disabled="@_busy">Пересмотреть план</button>
                            <button class="danger" @onclick="FinishWithoutValidation" disabled="@_busy">Завершить без валидации</button>
                        </div>
                    </section>
                }
                @if (Session.ExecutionInterrupted && Session.CurrentTask is not null)
                {
                    <section class="validation-recovery" role="alert">
                        <strong>Выполнение прервано</strong>
                        <details open><summary>Причина</summary><pre>@Session.CurrentTask.ExecutionResult</pre></details>
                        <div>
                            @if (Session.CurrentTask.ExecutionRetrySafe)
                            {
                                <button class="secondary" @onclick="RetryInterruptedExecutionAsync" disabled="@_busy">Повторить</button>
                                <button class="secondary" @onclick="SendAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_message))">Отправить уточнение</button>
                            }
                            else
                            {
                                <button class="secondary" @onclick="ValidateInterruptedExecutionAsync" disabled="@_busy">Перейти к валидации</button>
                            }
                            <button class="secondary" @onclick="ReplanInterruptedExecutionAsync" disabled="@_busy">Пересмотреть план</button>
                            <button class="danger" @onclick="CancelTask" disabled="@_busy">Отменить</button>
                        </div>
                    </section>
                }
                @if (_lastToolTraces.Count > 0)
                {
                    <details class="tool-details"><summary>Диагностика инструментов</summary>@foreach (var trace in _lastToolTraces) { <pre>@trace</pre> }</details>
                }
                <textarea @bind="_message" @bind:event="oninput" placeholder="Сообщение ассистенту" rows="3" disabled="@_busy"></textarea>
                <div class="composer-actions">
                    <span>@(_lastUsage ?? "Enter в поле переносит строку")</span>
                    @if (Session.AwaitingPlanApproval)
                    {
                        <div class="composer-buttons">
                            <button class="secondary" @onclick="CancelTask" disabled="@_busy">Отменить</button>
                            <button class="secondary" @onclick="SendAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_message))">Отправить уточнение</button>
                            <button class="primary" @onclick="ApprovePlanAsync" disabled="@_busy">Согласовать</button>
                        </div>
                    }
                    else if (Session.AwaitingClarification)
                    {
                        <div class="composer-buttons">
                            <button class="secondary" @onclick="CancelTask" disabled="@_busy">Отменить</button>
                            <button class="primary" @onclick="SendAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_message))">Ответить</button>
                        </div>
                    }
                    else if (Session.IsTaskPaused && !Session.ValidationFailed)
                    {
                        <button class="primary" @onclick="ContinueTaskAsync" disabled="@_busy">Продолжить</button>
                    }
                    else
                    {
                        <button class="primary" @onclick="SendAsync" disabled="@(_busy || TaskIsActive || string.IsNullOrWhiteSpace(_message))">Отправить</button>
                    }
                </div>
            </footer>
        }
        else if (_section == "profiles")
        {
            <header class="workspace-header"><div><h1>Профили</h1><p>Стиль, инструменты и контекст каждого режима работы</p></div><button class="primary" @onclick="NewProfile">Создать профиль</button></header>
            <section class="split-view">
                <div class="item-list">
                    @if (_profiles.Count == 0) { <p class="muted">Профили ещё не созданы.</p> }
                    @foreach (var profile in _profiles)
                    {
                        <button class="list-item @(profile.Name == _editingProfile?.Name ? "selected" : "")" @onclick="() => EditProfile(profile)">
                            <strong>@profile.Name</strong><span>@(profile.Name == _activeProfile?.Name ? "Активный" : "Выбрать и настроить")</span>
                        </button>
                    }
                </div>
                <EditForm Model="_profileDraft" OnValidSubmit="SaveProfileAsync" class="editor-form">
                    <h2>@(_isNewProfile ? "Новый профиль" : "Настройка профиля")</h2>
                    <label>Имя<input @bind="_profileDraft.Name" disabled="@(!_isNewProfile)" /></label>
                    <label>Style<textarea @bind="_profileDraft.Style" rows="5" placeholder="Например: отвечай кратко, используй русский язык..."></textarea></label>
                    <label>Constraints / Tooling<textarea @bind="_profileDraft.ConstraintsAndTooling" rows="6" placeholder="Стек, инструменты, ограничения и правила..."></textarea></label>
                    <label>Context<textarea @bind="_profileDraft.Context" rows="6" placeholder="Роль, текущий проект и другой полезный контекст..."></textarea></label>
                    <div class="form-actions">
                        @if (!_isNewProfile && _editingProfile is not null)
                        {
                            <button type="button" class="danger" @onclick="DeleteProfileAsync">Удалить</button>
                            @if (_editingProfile.Name != _activeProfile?.Name) { <button type="button" class="secondary" @onclick="SelectEditingProfileAsync">Выбрать</button> }
                        }
                        <button type="submit" class="primary">Сохранить и выбрать</button>
                    </div>
                </EditForm>
            </section>
        }
        else if (_section == "prompt")
        {
            <header class="workspace-header"><div><h1>Базовый prompt</h1><p>Системная инструкция перед профилем и памятью</p></div><span class="readonly-badge">Только чтение</span></header>
            <section class="prompt-view">
                <textarea readonly aria-label="Базовый системный prompt">@DesignerAssistantPrompt.Text</textarea>
            </section>
        }
        else if (_section == "invariants")
        {
            <header class="workspace-header"><div><h1>Инварианты</h1><p>Глобальные правила с наивысшим приоритетом</p></div><button class="primary" @onclick="SaveInvariantsAsync" disabled="@_busy">Сохранить</button></header>
            <section class="invariants-view">
                <textarea @bind="_invariants" @bind:event="oninput" aria-label="Глобальные инварианты" placeholder="Введите правила, которые ассистент не имеет права нарушать"></textarea>
            </section>
        }
        else if (_section == "memory")
        {
            <header class="workspace-header"><div><h1>Память</h1><p>Данные, которые агент добавляет в контекст</p></div><button class="secondary" @onclick="CompleteTaskAsync">Завершить задачу</button></header>
            <section class="memory-grid">
                <div><h2>Краткосрочная</h2><strong>@(_memory?.ShortTerm.Count ?? 0)</strong><p>сообщений текущего диалога</p></div>
                <div><h2>Рабочая</h2>@foreach (var entry in _memory?.Working ?? []) { <article><strong>@entry.Key</strong><p>@entry.Value</p></article> }</div>
                <div><h2>Долговременная</h2>@foreach (var entry in _memory?.LongTerm ?? []) { <article><strong>@entry.Key</strong><p>@entry.Value</p></article> }</div>
            </section>
        }
        else
        {
            <header class="workspace-header"><div><h1>Сеансы Revit</h1><p>Выберите документ для MCP-инструментов</p></div><button class="secondary" @onclick="OpenRevitAsync">Обновить</button></header>
            <section class="revit-list">
                @if (_revitSessions.Count == 0) { <p class="muted">Доступные сеансы не найдены.</p> }
                @foreach (var session in _revitSessions)
                {
                    <article><div><strong>@session.DisplayName</strong><span>PID @session.ProcessId</span></div><span class="availability @(session.IsRoutable ? "available" : "")">@(session.IsRoutable ? "Доступен" : "Не опубликован")</span><button class="secondary" disabled="@(!session.IsRoutable)" @onclick="() => SelectRevitAsync(session)">Выбрать</button></article>
                }
            </section>
        }
        @if (!string.IsNullOrWhiteSpace(_notice)) { <div class="notice"><span>@_notice</span><button title="Закрыть" aria-label="Закрыть уведомление" @onclick="() => _notice = null">×</button></div> }
    </main>
</div>

@if (Session.PendingTransaction is not null)
{
    <div class="modal-backdrop">
        <section class="confirmation" role="dialog" aria-modal="true" aria-labelledby="transaction-title">
            <h2 id="transaction-title">Транзакция Revit</h2>
            <p>Ассистент запрашивает изменение открытой модели.</p>
            <pre>@Session.PendingTransaction</pre>
            <div><button class="secondary" @onclick="() => ResolveTransaction(false)">Отменить</button><button class="danger-solid" @onclick="() => ResolveTransaction(true)">Разрешить изменение</button></div>
        </section>
    </div>
}

@code {
    private string _section = "chat";
    private string _message = "";
    private string _invariants = "";
    private string? _error, _notice, _lastUsage;
    private bool _ready, _busy, _isNewProfile = true;
    private bool _pauseAfterExecution, _pauseAfterValidation;
    private UserProfile? _activeProfile, _editingProfile;
    private UserProfileDraft _profileDraft = new();
    private IReadOnlyList<UserProfile> _profiles = [];
    private MemorySnapshot? _memory;
    private IReadOnlyList<RevitSession> _revitSessions = [];
    private IReadOnlyList<string> _lastToolTraces = [];
    private static readonly TaskState[] PrimaryTaskStages = [TaskState.Planning, TaskState.Execution, TaskState.Validation, TaskState.Done];

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        try { await Session.InitializeAsync(Environment.ContentRootPath); _activeProfile = await Session.GetProfileAsync(); _ready = true; }
        catch (Exception exception) { _error = exception.Message; }
    }

    private string NavClass(string section) => _section == section ? "active" : "";
    private void OpenSection(string section) { _section = section; _notice = null; }
    private async Task OpenProfilesAsync() { OpenSection("profiles"); await ReloadProfilesAsync(); }
    private async Task OpenInvariantsAsync() { OpenSection("invariants"); _invariants = await Session.GetInvariantsAsync(); }
    private async Task OpenMemoryAsync() { OpenSection("memory"); _memory = await Session.GetMemoryAsync(); }
    private async Task OpenRevitAsync() { OpenSection("revit"); try { _revitSessions = await Session.GetRevitSessionsAsync(); } catch (Exception e) { _notice = e.Message; } }

    private async Task SendAsync()
    {
        var text = _message.Trim(); if (text.Length == 0) return;
        _message = ""; _busy = true; _notice = null;
        try
        {
            if (Session.AwaitingPlanApproval)
                await Session.RefinePlanAsync(text);
            else if (Session.PlanningInterrupted)
                await Session.RefineInterruptedPlanningAsync(text);
            else if (Session.AwaitingClarification)
                await Session.SubmitClarificationAsync(text);
            else if (Session.ExecutionInterrupted)
                await Session.RefineInterruptedExecutionAsync(text);
            else
                await Session.StartTaskAsync(text, new TaskPauseOptions(true, _pauseAfterExecution, _pauseAfterValidation));
            UpdateTaskMetrics();
        }
        catch (Exception e) { _notice = e.Message; }
        finally { _busy = false; }
    }

    private async Task ApprovePlanAsync()
    {
        _busy = true; _notice = null;
        try { await Session.ApprovePlanAsync(); UpdateTaskMetrics(); }
        catch (Exception e) { _notice = e.Message; }
        finally { _busy = false; }
    }

    private async Task RetryPlanningAsync()
    {
        _busy = true; _notice = null;
        try { await Session.RetryPlanningAsync(); UpdateTaskMetrics(); }
        catch (Exception e) { _notice = e.Message; }
        finally { _busy = false; }
    }

    private async Task ContinueTaskAsync()
    {
        _busy = true; _notice = null;
        try { await Session.ContinueTaskAsync(); UpdateTaskMetrics(); }
        catch (Exception e) { _notice = e.Message; }
        finally { _busy = false; }
    }

    private async Task RetryValidationAsync()
    {
        _busy = true; _notice = null;
        try { await Session.RetryValidationAsync(); UpdateTaskMetrics(); }
        catch (Exception e) { _notice = e.Message; }
        finally { _busy = false; }
    }

    private async Task RetryExecutionAsync()
    {
        _busy = true; _notice = null;
        try { await Session.RetryExecutionAsync(); UpdateTaskMetrics(); }
        catch (Exception e) { _notice = e.Message; }
        finally { _busy = false; }
    }

    private async Task RetryInterruptedExecutionAsync()
    {
        _busy = true; _notice = null;
        try { await Session.RetryInterruptedExecutionAsync(); UpdateTaskMetrics(); }
        catch (Exception e) { _notice = e.Message; }
        finally { _busy = false; }
    }

    private async Task ValidateInterruptedExecutionAsync()
    {
        _busy = true; _notice = null;
        try { await Session.ValidateInterruptedExecutionAsync(); UpdateTaskMetrics(); }
        catch (Exception e) { _notice = e.Message; }
        finally { _busy = false; }
    }

    private async Task ReplanInterruptedExecutionAsync()
    {
        _busy = true; _notice = null;
        try { await Session.ReplanInterruptedExecutionAsync(); UpdateTaskMetrics(); }
        catch (Exception e) { _notice = e.Message; }
        finally { _busy = false; }
    }

    private async Task ReplanAsync()
    {
        _busy = true; _notice = null;
        try { await Session.ReplanAsync(); UpdateTaskMetrics(); }
        catch (Exception e) { _notice = e.Message; }
        finally { _busy = false; }
    }

    private void FinishWithoutValidation()
    {
        Session.FinishWithoutValidation();
        UpdateTaskMetrics();
        _notice = "Задача завершена без успешной валидации по решению пользователя.";
    }

    private async Task CancelTask()
    {
        await Session.CancelTaskAsync();
        UpdateTaskMetrics();
    }
    private bool TaskIsActive => Session.CurrentTask is { State: not (TaskState.Done or TaskState.Cancelled or TaskState.Failed) };
    private void UpdateTaskMetrics()
    {
        var response = Session.LastTaskResponse;
        if (response is null || Session.CurrentTask is null) return;
        _lastToolTraces = response.ToolTraces ?? [];
        _lastUsage = $"Этап: {Session.CurrentTask.State}; отправлено ≈{response.SentHistoryTokens:N0} токенов";
        if (response.ModelResponse.FinishReason == "task_state_validation_error")
            _notice = response.ModelResponse.Content;
    }

    private string TaskStageClass(TaskState state)
    {
        var current = Session.CurrentTask?.State;
        if (current is null) return "";
        var visibleCurrent = current switch
        {
            TaskState.AwaitingPlanApproval or TaskState.Clarification when Session.CurrentTask?.Clarification?.ResumeState != TaskState.Execution => TaskState.Planning,
            TaskState.PlanningInterrupted => TaskState.Planning,
            TaskState.AwaitingContinuation => Session.CurrentTask?.ResumeState == TaskState.Done ? TaskState.Validation : TaskState.Execution,
            TaskState.ExecutionInterrupted => TaskState.Execution,
            TaskState.AwaitingValidationDecision => TaskState.Validation,
            TaskState.Cancelled or TaskState.Failed => (TaskState?)null,
            _ => current
        };
        if (state == visibleCurrent) return "current";
        return visibleCurrent is not null && state < visibleCurrent ? "complete" : "";
    }

    private static string TaskStageCaption(TaskState state) => state switch
    {
        TaskState.Planning => "План",
        TaskState.PlanningInterrupted => "Планирование прервано",
        TaskState.AwaitingPlanApproval => "Согласование",
        TaskState.Execution => "Выполнение",
        TaskState.Clarification => "Уточнение",
        TaskState.Validation => "Проверка",
        TaskState.AwaitingValidationDecision => "Требуется решение",
        TaskState.AwaitingContinuation => "Пауза",
        TaskState.Done => "Готово",
        TaskState.Cancelled => "Отменено",
        TaskState.Failed => "Ошибка",
        TaskState.ExecutionInterrupted => "Выполнение прервано",
        _ => ""
    };

    private static string MessageLabel(ChatMessage message) => message.Role == "user"
        ? "Вы"
        : message.Stage switch
        {
            TaskState.Planning => "Ассистент · Планирование",
            TaskState.AwaitingPlanApproval => "Ассистент · План",
            TaskState.Execution => "Ассистент · Выполнение",
            TaskState.Clarification => "Ассистент · Уточнение",
            TaskState.Validation => "Ассистент · Валидация",
            TaskState.Done => "Ассистент · Итог",
            _ => "Ассистент"
        };

    private static bool IsCollapsibleStageMessage(ChatMessage message) =>
        message.Role == "assistant" && message.Stage is TaskState.Planning or TaskState.Execution;

    private bool ShouldExpandStageMessage(ChatMessage message) =>
        message.Stage == TaskState.Planning && Session.AwaitingPlanApproval && message == Session.History.LastOrDefault();

    private async Task ClearHistoryAsync() { await Session.ClearHistoryAsync(); _notice = "Диалог очищен."; }
    private async Task CompleteTaskAsync() { await Session.CompleteTaskAsync(); _memory = await Session.GetMemoryAsync(); _notice = "Рабочая память очищена."; }
    private async Task SaveInvariantsAsync()
    {
        _busy = true; _notice = null;
        try { await Session.SaveInvariantsAsync(_invariants); _notice = "Инварианты сохранены."; }
        catch (Exception e) { _notice = e.Message; }
        finally { _busy = false; }
    }
    private void NewProfile() { _isNewProfile = true; _editingProfile = null; _profileDraft = new(); }
    private void EditProfile(UserProfile profile) { _isNewProfile = false; _editingProfile = profile; _profileDraft = UserProfileDraft.From(profile); }

    private async Task SaveProfileAsync()
    {
        if (string.IsNullOrWhiteSpace(_profileDraft.Name)) { _notice = "Укажите имя профиля."; return; }
        if (_isNewProfile && _profiles.Any(p => p.Name.Equals(_profileDraft.Name, StringComparison.OrdinalIgnoreCase))) { _notice = "Профиль с таким именем уже существует."; return; }
        await Session.SaveProfileAsync(_profileDraft.ToProfile());
        await ReloadProfilesAsync(); _notice = "Профиль сохранён и выбран.";
    }

    private async Task SelectEditingProfileAsync() { if (_editingProfile is null) return; await Session.SelectProfileAsync(_editingProfile.Name); await ReloadProfilesAsync(); _notice = "Профиль выбран."; }
    private async Task DeleteProfileAsync() { if (_editingProfile is null) return; await Session.SelectProfileAsync(_editingProfile.Name); await Session.DeleteProfileAsync(); NewProfile(); await ReloadProfilesAsync(); _notice = "Профиль удалён."; }
    private async Task ReloadProfilesAsync() { _profiles = await Session.GetProfilesAsync(); _activeProfile = await Session.GetProfileAsync(); if (_editingProfile is null && _profiles.Count > 0) EditProfile(_activeProfile ?? _profiles[0]); }
    private async Task SelectRevitAsync(RevitSession session) { _notice = await Session.SelectRevitSessionAsync(session.ProcessId.ToString()); }
    private void ResolveTransaction(bool approved) => Session.ResolveTransaction(approved);
    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Session.Changed -= OnSessionChanged;

    private sealed class UserProfileDraft
    {
        public string Name { get; set; } = "";
        public string Style { get; set; } = "";
        public string ConstraintsAndTooling { get; set; } = "";
        public string Context { get; set; } = "";
        public UserProfile ToProfile() => new(Name.Trim(), Style.Trim(), ConstraintsAndTooling.Trim(), Context.Trim());
        public static UserProfileDraft From(UserProfile profile) => new() { Name = profile.Name, Style = profile.Style, ConstraintsAndTooling = profile.ConstraintsAndTooling, Context = profile.Context };
    }
}
